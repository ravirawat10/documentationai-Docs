                  enum: [aac, opus]
                  example: aac
                f:
                  type: string
                  description: "Output container format. Selecting this auto-populates codec defaults."
                  enum: [mp4, webm, hls, hlsaes]
                  example: mp4
                filemode:
                  type: string
                  description: "Output file organization. single = one output file per profile. combined = multi-bitrate HLS manifest bundle."
                  enum: [single, combined]
                  example: single
                fps:
                  type: string
                  description: "Target output frame rate as string. 0 copies the source frame rate."
                  enum: ["0", "24", "25", "30", "48", "50", "60"]
                  example: "30"
                gop:
                  type: string
                  description: "Group of Pictures size (frames between keyframes). Smaller values improve seeking accuracy. Typical range 24–300."
                  example: "60"
                preset:
                  type: string
                  description: "Encoding speed preset. Slower presets produce smaller files at the cost of encoding time."
                  enum: [ultrafast, superfast, veryfast, faster, fast, medium, slow, slower, veryslow]
                  example: veryfast
                vlevel:
                  type: string
                  description: "Codec encoding level constraining maximum resolution, frame rate, and bitrate. Valid values depend on cv and vprofile."
                  enum: ["3.0", "3.1", "3.2", "4.0", "4.1", "4.2", "5.0", "5.1", "5.2", "6.0", "6.1", "6.2"]
                  example: "4.1"
                vprofile:
                  type: string
                  description: "Codec-specific encoding profile. H.264 (libx264): baseline, main, high. H.265 (libx265): main, main10. VP9 (libvpx-vp9): profile0, profile2. Available values are constrained by cv."
                  example: high
                vpass:
                  type: string
                  description: "Number of encoding passes. 1 = faster single-pass. 2 = two-pass for more accurate bitrate targeting."
                  enum: ["1", "2"]
                  example: "1"
                tune:
                  type: string
                  description: "H.264 encoding tune preset; only applicable when cv=libx264. disabled = no tune applied."
                  enum: [disabled, film, animation, grain, stillimage, fastdecode]
                  example: film
                bv:
                  type: string
                  description: "Video bitrate mode. 0 = As Source (copies source bitrate). 1 = As Defined (use bvvalue to set target kbps)."
                  enum: ["0", "1"]
                  example: "1"
                bvvalue:
                  type: string
                  description: "Target video bitrate in kilobits per second, sent as a string. Required when bv=1."
                  example: "4000"
                ba:
                  type: string
                  description: "Audio bitrate mode. 0 = As Source (copies source bitrate). 1 = As Defined (use bavalue to set target kbps). Forced to 1 when f=webm."
                  enum: ["0", "1"]
                  example: "1"
                bavalue:
                  type: string
                  description: "Target audio bitrate in kilobits per second, sent as a string. Required when ba=1."
                  example: "128"
                sv:
                  type: string
                  description: "Output resolution. Use as_defined to specify custom dimensions via svvalue. Use 0 to preserve source resolution."
                  enum: ["2160p", "1440p", "1080p", "720p", "576p", "480p", "360p", "240p", "144p", "0", "as_defined"]
                  example: "720p"
                svvalue:
                  type: string
                  description: "Custom output dimensions as a single WIDTHxHEIGHT string. Only used when sv=as_defined. Both dimensions must be divisible by 2."
                  example: "1920x800"
                crfv:
                  type: string
                  description: "Constant Rate Factor for quality-based encoding. Lower value = better quality. Range 0–51; typical H.264 range is 18–28."
                  example: "24"
                ara:
                  type: string
                  description: "Audio sample rate in Hz. 0 preserves the source sample rate."
                  enum: ["0", "44100", "48000"]
                  example: "48000"
                aca:
                  type: string
                  description: "Audio output channel count. 0 = As Source. 1 = Mono. 2 = Stereo."
                  enum: ["0", "1", "2"]
                  example: "2"
                bframe:
                  type: string
                  description: "Number of consecutive B-frames. Higher values improve compression efficiency."
                  enum: ["0", "1", "2", "3", "4"]
                  example: "2"
                tm:
                  type: string
                  description: "Thumbnail generation mode. interval = generate thumbnails at periodic intervals. fixed = generate thumbnail at exact time tv. disabled = no thumbnails."
                  enum: [interval, fixed, disabled]
                  example: interval
                tv:
                  type: string
                  description: "Thumbnail time value in HH:MM:SS format. Required when tm=interval or tm=fixed."
                  example: "0:01:30"
                upscale:
                  type: string
                  description: "Whether to allow upscaling when the target resolution exceeds the source resolution. Y = allow upscaling. N = skip if source is lower resolution."
                  enum: ["Y", "N"]
                  example: "N"
                sourcevideo:
                  type: string
                  description: "Whether to include the video stream in the output. N = creates audio-only output."
                  enum: ["Y", "N"]
                  example: "Y"
                sourceaudio:
                  type: string
                  description: "Whether to include the audio stream in the output. N = creates video-only output."
                  enum: ["Y", "N"]
                  example: "Y"
                hlsUnifiedSegments:
                  type: boolean
                  description: "Enables MPEG-TS segment format for HLS output. Defaults to false."
                  example: false
                hlsfMP4Segments:
                  type: boolean
                  description: "Enables fragmented MP4 format for HLS output; improves seeking. Mutually exclusive with hlsUnifiedSegments."
                  example: false
                outdir:
                  type: string
                  description: "Output directory path relative to the storage root. Empty string stores in root. Characters < > : \\ | ? * are not allowed."
                  example: "output/hd"
                filters:
                  type: array
                  description: Array of filter IDs to apply as video overlays during encoding.
                  items:
                    type: string
                  example: ["1"]
                profiles:
                  type: array
                  description: Sub-profiles.
                  items:
                    type: string
                  example: []
                _METHOD:
                  type: string
                  description: Signal DELETE to the backend when deleting.
                  example: DELETE
      deprecated: false
      responses:
        '200':
          description: success
          content:
            application/json:
              schema:
                type: object
                properties:
                  result:
                    type: string
                    description: API response status.
                    example: success
                  message:
                    type: string
                    description: Human-readable result or error message.
                    example: Transcoding Settings Updated
    delete:
      tags:
      - Preset Profile
      summary: Delete Transcoding Profile
      description: >
        Delete the information of a transcoding profile. To cast request method
        POST, include parameter _METHOD = DELETE.
      operationId: deleteTranscodingProfile
      parameters:
      - $ref: '#/components/parameters/profileIdParam'
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required:
              - _METHOD
              properties:
                _METHOD:
                  type: string
                  description: Signals DELETE to the backend.
                  enum: [DELETE]
                  example: DELETE
      deprecated: false
      responses:
        '200':
          description: success
          content:
            application/json:
              schema:
                type: object
                properties:
                  result:
                    type: string
                    description: API response status.
                    example: success
                  message:
                    type: string
                    description: Human-readable result or error message.
                    example: Transcoding Settings Updated

