  /transcoding/filters/new:
    post:
      tags:
      - Filter
      summary: Create File Transcoding Filter
      description: Create a new file transcoding filter.
      operationId: createVideoTranscodingFilter
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required:
              - name
              - filter
              - _METHOD
              properties:
                name:
                  type: string
                  description: Filter name.
                  example: flutter
                filter:
                  type: string
                  description: "Filter category. overlay = apply image/logo watermark. drawtext = render text overlay on video."
                  enum: [overlay, drawtext]
                  example: overlay
                args[overlay][url]:
                  type: string
                  description: "Public HTTP/HTTPS URL of the watermark image. PNG recommended for transparency. Required when filter=overlay."
                  example: "https://cdn.example.com/logo.png"
                args[overlay][scale]:
                  type: string
                  description: "Watermark image size as a percentage of the output video frame width. Required when filter=overlay."
                  example: "10"
                args[overlay][position]:
                  type: string
                  description: "Position of the watermark on the video frame. Required when filter=overlay."
                  enum: [top_left, top_right, bottom_left, bottom_right, center]
                  example: top_right
                args[drawtext][text]:
                  type: string
                  description: "Text string to render as overlay on video. Required when filter=drawtext."
                  example: "© 2024 My Brand"
                args[drawtext][fontsize]:
                  type: integer
                  description: "Font size of text overlay in pixels. Required when filter=drawtext."
                  example: 24
                args[drawtext][fontcolor]:
                  type: string
                  description: "Color of text overlay. Accepts CSS hex (#RRGGBB) or FFmpeg named colors (white, black, etc.). Required when filter=drawtext."
                  example: "#FFFFFF"
                args[drawtext][position]:
                  type: string
                  description: "Position of the text overlay on the video frame. Required when filter=drawtext."
                  enum: [top_left, top_right, bottom_left, bottom_right, center]
                  example: top_left
                _METHOD:
                  type: string
                  description: To cast request method POST to PUT.
                  enum: [PUT]
                  example: PUT
      responses:
        '200':
          description: success
          content:
            application/json:
              schema:
                type: object
                properties:
                  result:
                    type: string
                    description: API response status.
                    example: success
                  message:
                    type: string
                    description: Human-readable result or error message.
                    example: "Transcoding Settings, New Filter Created"
                  filterid:
                    type: integer
                    description: Unique identifier of the newly created filter.
                    example: 429

  /transcoding/filters/{filterid}:
    post:
      tags:
      - Filter
      summary: Edit Transcoding Profile Filter
      description: Edit an existing transcoding profile filter.
      operationId: editVideoTranscodingFilter
      parameters:
      - $ref: '#/components/parameters/filterIdParam'
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              properties:
                name:
                  type: string
                  description: The name associated with the configuration or filter.
                  example: flutter
                filter:
                  type: string
                  description: "Filter category. overlay = apply image/logo watermark. drawtext = render text overlay on video."
                  enum: [overlay, drawtext]
                  example: drawtext
                args[overlay][url]:
                  type: string
                  description: "Public HTTP/HTTPS URL of the watermark image. PNG recommended for transparency. Required when filter=overlay."
                  example: "https://cdn.example.com/logo.png"
                args[overlay][scale]:
                  type: string
                  description: "Watermark image size as a percentage of the output video frame width. Required when filter=overlay."
                  example: "10"
                args[overlay][position]:
                  type: string
                  description: "Position of the watermark on the video frame."
                  enum: [top_left, top_right, bottom_left, bottom_right, center]
                  example: top_right
                args[text]:
                  type: string
                  description: "Text string to render as overlay on video. Required when filter=drawtext."
                  example: "© 2024 My Brand"
                args[fontsize]:
                  type: integer
                  description: "Font size of text overlay in pixels. Required when filter=drawtext."
                  example: 24
                args[fontcolor]:
                  type: string
                  description: "Color of text overlay. Accepts CSS hex (#RRGGBB) or FFmpeg named colors. Required when filter=drawtext."
                  example: "#FFFFFF"
                args[position]:
                  type: string
                  description: "Position of the text overlay on the video frame."
                  enum: [top_left, top_right, bottom_left, bottom_right, center]
                  example: top_left
      deprecated: false
      responses:
        '200':
          description: success
          content:
            application/json:
              schema:
                type: object
                properties:
                  result:
                    type: string
                    description: API response status.
                    example: success
                  message:
                    type: string
                    description: Human-readable result or error message.
                    example: Transcoding Settings Updated
    delete:
      tags:
      - Filter
      summary: Delete Transcoding Profile Filter
      description: >
        Delete the information of a transcoding profile filter. To cast request
        method POST, include parameter _METHOD = DELETE.
      operationId: deleteVideoTranscodingFilter
      parameters:
      - $ref: '#/components/parameters/filterIdParam'
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required:
              - _METHOD
              properties:
                _METHOD:
                  type: string
                  description: Signals DELETE to the backend.
                  enum: [DELETE]
                  example: DELETE
      deprecated: false
      responses:
        '200':
          description: success
          content:
            application/json:
              schema:
                type: object
                properties:
                  result:
                    type: string
                    description: API response status.
                    example: success
                  message:
                    type: string
                    description: Human-readable result or error message.
                    example: Transcoding Filter Deleted

  # ---------------------------------------------------------------------------
  # Transcoding Notifications
  # ---------------------------------------------------------------------------
  /transcoding/notifications/defaults:
    post:
      tags:
      - Notifications
      summary: Save Notification Emails and Webhook URLs
      description: >
        Updates email addresses and webhook URLs for encode-completion
        notifications. The emails field is a comma-separated list of email
        addresses; webhooks is a comma-separated list of HTTP/HTTPS URLs.
      operationId: updateNotifications
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              properties:
                emails:
                  type: string
                  description: >
                    Comma-separated list of email addresses to receive
                    encode-completion notifications.
                  example: "admin@example.com,ops@example.com"
                webhooks:
                  type: string
                  description: >
                    Comma-separated list of HTTP/HTTPS URLs to POST
                    encode-completion payloads to.
                  example: "https://hooks.example.com/encode,https://api.example.com/notify"
      responses:
        '200':
          description: success
          content:
            application/json:
              schema:
                type: object
                properties:
                  result:
                    type: string
                    description: API response status.
                    example: success
                  message:
                    type: string
                    description: Human-readable result or error message.
                    example: Transcoding Settings Updated

  /transcoding/notifications/resend:
    post:
      tags:
      - Notifications
      summary: Resend Encode-Completion Webhook Notification
      description: >
        Looks up a completed encode job and re-POSTs the original completion
        payload to all configured webhook URLs. Exactly one of index, infile,
        or outfile must be provided along with zoneid.
      operationId: resendNotification
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required:
              - zoneid
              - index
              properties:
                zoneid:
                  type: integer
                  description: Zone ID for which the notification should be resent.
                  example: 1234
                index:
                  type: integer
                  description: Index of the transcoding job notification to resend.
                  example: 0
      responses:
        '200':
          description: Array of webhook call results.
          content:
            application/json:
              schema:
                type: array
                items:
                  type: object
                  properties:
                    time:
                      type: integer
                      description: Unix timestamp of the call.
                      example: 1742810400
                    hook:
                      type: string
                      description: Webhook URL that was called.
                      example: "https://hooks.example.com/encode"
                    body:
                      type: array
                      description: JSON payload posted to the webhook.
                      items:
                        type: object
                    respCode:
                      type: integer
                      description: HTTP response status code from the webhook endpoint.
                      example: 200
                    respBody:
                      type: string
                      description: HTTP response body from the webhook endpoint.
                      example: "OK"
                    error:
                      type: string
                      description: Exception message if the HTTP call threw an exception.
        '400':
          description: Lookup or configuration error.
          content:
            application/json:
              schema:
                type: object
                properties:
                  error:
                    type: string
                    description: Error message if the encoding job failed.
                    example: "No Match Found"

components:
  securitySchemes:
    ApiKeyAuth:
      type: apiKey
      in: header
      name: X-API-Key

  parameters:
    zoneIdParam:
      name: zoneId
      in: path
      description: ID of the Push Zone (`fs_pushzones.id`).
      required: true
      style: simple
      explode: false
      schema:
        type: integer
        example: 15

    jobIdParam:
      name: jobid
      in: path
      description: ID of the Video Encoding job (Beanstalkd job ID stored in `fs_encodejobs.jobid`).
      required: true
      style: simple
      explode: false
      schema:
        type: integer
        example: 10042

    profileIdParam:
      name: profileid
      in: path
      description: ID of the Transcode Profile (`fs_transcodeprofiles.id`).
      required: true
      style: simple
      explode: false
      schema:
        type: integer
        example: 7

    filterIdParam:
      name: filterid
      in: path
      description: ID of the Transcoding Filter (`fs_transcodefilters.id`).
      required: true
      style: simple
      explode: false
      schema:
        type: integer
        example: 3

  schemas:
    createProfileCombined:
      type: object

    editProfileCombined:
      type: object

    createFileTranscodingFilter:
      type: object

    editFileTranscodingFilter:
      type: object
