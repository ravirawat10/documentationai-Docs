          example: "1h"
        match:
          type: string
          description: Autonomous System Name (ASN) to filter by. Must match the `key` field returned in the breakdown response.
          example: Sample ISP Network
          x-examples:
          - Sample ISP Network
          - Sample Telecom Provider

    TrafficCacheLineRequest:
      type: object
      required: [r, match]
      description: |
        If `resource_type` is `all`, omit `resource_hashes`.
        If `resource_type` is a specific type, `resource_hashes` must be provided.
      properties:
        r:
          type: string
          description: Date range in "YYYY-MM-DD HH:mm:ss - YYYY-MM-DD HH:mm:ss" format (UTC).
          example: "2026-01-01 00:00:00 - 2026-01-31 23:59:59"
        resource_type:
