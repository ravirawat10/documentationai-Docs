            Required when resource_type is push, pull, or livestream. Omit when resource_type is all.
          example: ["abc12hash", "def34hash", "ghi56hash"]
        granularity:
          type: string
          description: Defines the time interval for data aggregation.
          enum: ["1m", "5m", "15m", "30m", "1h", "3h", "6h", "12h", "24h"]
          example: "1h"
        match:
          type: string
          description: Cache status to filter by. Must match the `key` field returned in the breakdown response.
          enum: [HIT, MISS, EXPIRED, BYPASS, STALE, REVALIDATED, "-"]
          example: MISS
          x-examples:
          - MISS
          - HIT

    TrafficFilterRequest:
      type: object
      required: [r]
      description: |
        If `resource_type` is `all`, omit `resource_hashes`.
        If `resource_type` is a specific type, `resource_hashes` must be provided.
